# 自动 HTTPS：Caddy 启动即向 Let's Encrypt 申请证书（需 DNS 已生效 + 80/443 可达）
# 更换域名时改这里 + compose 里 ACME_EMAIL
{
	email {$ACME_EMAIL}
}

factur-x-api.com, www.factur-x-api.com {
	encode zstd gzip
	# 访问日志（JSON 到 stdout，docker logs 可见；compose 已限制 10m×3 滚动）
	log {
		format json
	}
	# Reddit Markdown 会把链接结尾的 ) 吞进 URL，接住这些 404 访客
	redir /validateur-factur-x) /validateur-factur-x 301
	redir /docs) /docs 301
	# 白名单：校验/生成/健康检查 + 公开领 key + LS webhook；/api/admin/* 不对外（发 key 须 SSH 走内网）
	@api path /api/validate /api/generate /api/health /api/keys /api/webhook/lemonsqueezy
	handle @api {
		reverse_proxy api:8081
	}
	handle {
		reverse_proxy app:8080
	}
}
